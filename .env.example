# Required for live YouTube search/status verification.
YOUTUBE_API_KEY="your_youtube_data_api_key"

# Required for durable multi-instance/serverless cloud sync (Upstash/Vercel KV REST API).
KV_REST_API_URL="https://your-kv-endpoint"
KV_REST_API_TOKEN="your_kv_rest_token"

# Optional local Node server port.
PORT="3000"
